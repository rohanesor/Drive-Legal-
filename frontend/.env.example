# Environment variables required for DriveLegal frontend

# Convex deployment configuration
CONVEX_DEPLOYMENT=your_convex_deployment_name_here
CONVEX_URL=your_convex_database_url_here
CONVEX_SITE_URL=your_convex_site_url_here

# Sentry Auth Token (used during build/upload)
# IMPORTANT: DO NOT commit your actual auth token to version control!
SENTRY_AUTH_TOKEN=your_sentry_auth_token_here

# Sentry DSN (client-side)
EXPO_PUBLIC_SENTRY_DSN=your_sentry_dsn_here
